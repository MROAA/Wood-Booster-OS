import express from 'express';
// Importataan luomasi Git Guardian -reititin
import gitGuardianRouter from './services/spacemonkey/modules/gitGuardian/index.js';

const app = express();

// Middlewaret (varmista että JSON-parseri on käytössä)
app.use(express.json());

// --- REITTISUORITUS / API-INTEGRAATIO ---
// Kytketään Git Guardian /api/gitguardian -polkuun
app.use('/api/gitguardian', gitGuardianRouter);

// Palvelimen käynnistys
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`🚀 Wood-Booster HQ käynnissä portissa ${PORT}`);
  console.log(`🛡️  Git Guardian aktiivinen osoitteessa http://localhost:${PORT}/api/gitguardian/status`);
});
