generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id Int @id @default(autoincrement())

  name String

  company String?

  email String?

  phone String?

  notes String?

  projects Project[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Project {
  id Int @id @default(autoincrement())

  name String

  status String @default("Suunnittelu")

  notes String?

  customerId Int?

  customer Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Conversation {
  id String @id @default(cuid())

  title String?

  messages Message[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Message {
  id String @id @default(cuid())

  role String

  content String

  conversationId String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Memory {
  id Int @id @default(autoincrement())

  category String @default("general")

  key String

  content String

  importance Int @default(5)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model MemoryProposal {
  id Int @id @default(autoincrement())

  category String

  key String

  content String

  importance Int

  status String @default("pending")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model KnowledgeDocument {
  id Int @id @default(autoincrement())

  title String

  content String

  topic String @default("general")

  folder String @default("Yleinen")

  tags String?

  author String?

  sourceType String @default("text")

  sourceUrl String?

  status String @default("Luonnos")

  priority Int @default(3)

  confidence Int @default(100)

  alwaysUse Boolean @default(false)

  chunks KnowledgeChunk[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model KnowledgeChunk {
  id Int @id @default(autoincrement())

  content String

  chunkIndex Int

  tokenCount Int @default(0)

  documentId Int

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model InventoryItem {
  id Int @id @default(autoincrement())

  name String

  category String?

  quantity Float @default(0)

  unit String @default("kpl")

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Purchase {
  id Int @id @default(autoincrement())

  name String

  supplier String?

  price Float @default(0)

  status String @default("Suunnittelu")

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
