      "critical_files":

      [

        "01_identity.json",

        "02_core_values.json",

        "06_reasoning_principles.json",

        "14_spacemonkey_system_contract.json",

        "32_spacemonkey_core_schema.json"

      ],


      "failure_behavior":

      [

        "Stop activation",

        "Report missing component",

        "Do not create incomplete identity"

