{
  "spacemonkey_loader_architecture": {

    "version": "1.0.0",

    "purpose":

    "Defines how Spacemonkey identity files are loaded, validated and transformed into a runtime intelligence core.",


    "core_principle":

    "The loader does not create Spacemonkey. The loader activates the defined identity system.",


    "loading_pipeline": {


      "stage_1":

      {

        "name":

        "Discovery",


        "purpose":

        "Find all required Spacemonkey identity files.",


        "actions":

        [

          "Locate personality directory",

          "Read core schema",

          "Identify required files"

        ]

      },


      "stage_2":

      {

        "name":

        "Validation",


        "purpose":

        "Verify that identity data is complete and usable.",


        "checks":

        [

          "File exists",

          "JSON is valid",

          "Version is compatible",

          "Required sections exist"

        ]

      },


      "stage_3":

      {

        "name":

        "Parsing",


        "purpose":

        "Convert files into structured intelligence data.",


        "actions":

        [

          "Parse JSON files",

          "Read markdown documents",

          "Normalize structure"

        ]

      },


      "stage_4":

      {

        "name":

        "Assembly",


        "purpose":

        "Combine all identity layers into one Core object.",


        "output":

        "SpacemonkeyCore"

      },


      "stage_5":

      {

        "name":

        "Activation",


        "purpose":

        "Provide personality context to AI Brain runtime."

