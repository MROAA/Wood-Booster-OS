generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id Int @id @default(autoincrement())

  name String

  company String?

  email String?

  phone String?

  notes String?

  projects Project[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Project {
  id Int @id @default(autoincrement())

  name String

  status String @default("Suunnittelu")

  notes String?

  customerId Int?

  customer Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Conversation {
  id String @id @default(cuid())

  title String?

  messages Message[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Message {
  id String @id @default(cuid())

  role String

  content String

  conversationId String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Memory {
  id Int @id @default(autoincrement())

  category String @default("general")

  key String

  content String

  importance Int @default(5)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model MemoryProposal {
  id Int @id @default(autoincrement())

  category String

  key String

  content String

  importance Int

  status String @default("pending")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model KnowledgeDocument {
  id Int @id @default(autoincrement())

  title String

  content String

  topic String @default("general")

  folder String @default("Yleinen")

  tags String?

  author String?

  sourceType String @default("text")

  sourceUrl String?

  status String @default("Luonnos")

  priority Int @default(3)

  confidence Int @default(100)

  alwaysUse Boolean @default(false)

  chunks KnowledgeChunk[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model KnowledgeChunk {
  id Int @id @default(autoincrement())

  content String

  chunkIndex Int

  tokenCount Int @default(0)

  documentId Int

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model InventoryItem {
  id Int @id @default(autoincrement())

  name String

  category String?

  quantity Float @default(0)

  unit String @default("kpl")

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Purchase {
  id Int @id @default(autoincrement())

  name String

  supplier String?

  price Float @default(0)

  status String @default("Suunnittelu")

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model SpacemonkeyActivity {
  id String @id @default(cuid())

  type String

  module String

  status String

  message String

  metadata String?

  createdAt DateTime @default(now())
}

model SpacemonkeyApproval {
  id String @id @default(cuid())

  approved Boolean @default(false)

  status String

  risk String?

  filePath String?

  instruction String?

  changePlan String?

  reasons String?

  requirements String?

  nextAction String?

  createdAt DateTime @default(now())

  approvedAt DateTime?
}

model SpacemonkeyRoot {
  id Int @id @default(autoincrement())

  key String @unique

  value String

  category String @default("system")

  importance Int @default(5)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model SpacemonkeySnapshot {
  id Int @id @default(autoincrement())

  filename String

  path String

  version String

  description String?

  status String @default("created")

  createdAt DateTime @default(now())
}

model SpacemonkeySnapshotAudit {
  id Int @id @default(autoincrement())

  event String

  module String

  changeType String

  risk String

  snapshot String?

  status String @default("completed")

  message String?

  createdAt DateTime @default(now())
}

model SpacemonkeyWorldEntity {
  id String @id @default(cuid())

  name String

  type String

  description String?

  metadata String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  outgoingRelations SpacemonkeyWorldRelation[] @relation("WorldRelationFrom")

  incomingRelations SpacemonkeyWorldRelation[] @relation("WorldRelationTo")
}

model SpacemonkeyWorldRelation {
  id String @id @default(cuid())

  fromEntityId String

  toEntityId String

  type String

  description String?

  createdAt DateTime @default(now())

  fromEntity SpacemonkeyWorldEntity @relation("WorldRelationFrom", fields: [fromEntityId], references: [id])

  toEntity SpacemonkeyWorldEntity @relation("WorldRelationTo", fields: [toEntityId], references: [id])
}
