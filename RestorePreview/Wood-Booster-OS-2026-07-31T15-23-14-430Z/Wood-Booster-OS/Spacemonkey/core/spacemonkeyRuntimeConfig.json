{
  "system": "Spacemonkey Runtime Configuration",
  "version": "1.0.0",

  "description": "Spacemonkeyn ajonaikainen toimintakonfiguraatio. Määrittää miten keskusyksikkö toimii, oppii, suunnittelee ja suorittaa tehtäviä.",

  "environment": {
    "name": "Wood-Booster OS",
    "mode": "development",
    "localOnly": true,
    "owner": "Marc Järvinen"
  },

  "identity": {
    "enabled": true,
    "loadFirst": true,
    "source": "spacemonkeyGodFileIndex.json"
  },

  "memory": {
    "enabled": true,

    "learning": {
      "enabled": true,
      "requireValidation": true
    },

    "storage": {
      "type": "database",
      "persistent": true
    },

    "rules": {
      "avoidDuplicateMemories": true,
      "preferImportantInformation": true,
      "respectUserControl": true
    }
  },

  "reasoning": {

    "truthChecking": {
      "enabled": true,
      "preferTruthOverCompletion": true
    },

    "decisionMaking": {
      "enabled": true,
      "useValues": true,
      "evaluateRisk": true
    },

    "planning": {
      "enabled": true,
      "method": "MVP",
      "smallSteps": true
    }

  },

  "development": {

    "codingAssistant": {
      "enabled": true,

      "rules": {
        "analyzeBeforeChanging": true,
        "preferCompleteFiles": true,
        "testBeforeNextStep": true,
        "preserveExistingArchitecture": true
      }
    },

    "workflow": {
      "enabled": true,
      "trackChanges": true,
      "requireApproval": true
    },

    "release": {
      "enabled": true,
      "reviewRequired": true
    }

  },

  "communication": {

    "language": "fi",

    "style": {
      "clear": true,
      "stepByStep": true,
      "practical": true,
      "avoidUnnecessaryPoliteness": true
    }

  },

  "execution": {

    "autonomousActions": false,

    "requireConfirmation": [
      "code_changes",
      "file_writes",
      "system_changes"
    ],

    "safeMode": true

  },

  "runtime": {

    "activeModules": [
      "identity",
      "personality",
      "memory",
      "truth",
      "decision",
      "planning",
      "coding",
      "workflow",
      "dashboard"
    ],

    "logging": {
      "enabled": true,
      "history": true
    }

  },

  "rules": {

    "protectCoreIdentity": true,

    "respectGodFiles": true,

    "preserveUserIntent": true,

    "growThroughKnowledge": true,

    "neverSkipValidation": true

  },

  "created": "2026-07-26",

  "maintainer": "Marc Järvinen"
}
