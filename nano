function isInvalidMemory(memory){

  const content =
    String(
      memory.content || ""
    )
    .toLowerCase()
    .trim()


  const blockedStarts = [

    "mitä muistat",

    "miten haluan",

    "mikä on",

    "mikä",

    "kuinka",

    "milloin",

    "missä",

    "kuka"

  ]


  return blockedStarts.some(

    prefix =>
      content.startsWith(prefix)

  )

}