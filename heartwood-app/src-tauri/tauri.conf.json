{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",

  "productName": "Heartwood Trial",

  "version": "0.1.0",

  "identifier": "heartwood-trial",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Heartwood Trial",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,

    "targets": "all",

    "category": "Game",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
