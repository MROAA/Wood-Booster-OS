{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",

  "productName": "Wood-Booster HQ",

  "version": "0.1.0",

  "identifier": "wood-booster-hq",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wood-Booster HQ",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,

    "targets": "all",

    "category": "Business",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "resources": [
      "resources/server",
      "resources/pybackend"
    ],

    "externalBin": [
      "binaries/wood-booster-server",
      "binaries/wood-booster-python"
    ],

    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
