{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Wood-Booster OS",
  "version": "0.1.0",
  "identifier": "com.woodbooster.os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Wood-Booster OS",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/server",
      "resources/services"
    ],
    "externalBin": [
      "binaries/wood-booster-server"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
