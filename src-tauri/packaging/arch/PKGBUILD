pkgname=wood-booster-hq
pkgver=0.1.0
pkgrel=4
pkgdesc="Wood-Booster HQ desktop application"
arch=('x86_64')
url="https://github.com/MROAA/Wood-Booster-OS"
license=('custom')

depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'libappindicator-gtk3'
  'librsvg'
)

options=('!strip')

install=wood-booster-hq.install

source=(
  "wood-booster-hq"
  "wood-booster-server"
  "wood-booster-python"
  "wood-booster-hq.desktop"
  "icon-32.png"
  "icon-128.png"
  "icon-256.png"
  "icon-512.png"
)

sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
)

package() {

  install -Dm755 \
    "$srcdir/wood-booster-hq" \
    "$pkgdir/usr/bin/wood-booster-hq"

  install -Dm755 \
    "$srcdir/wood-booster-server" \
    "$pkgdir/usr/bin/wood-booster-server"

  install -Dm755 \
    "$srcdir/wood-booster-python" \
    "$pkgdir/usr/bin/wood-booster-python"

  install -Dm644 \
    "$srcdir/wood-booster-hq.desktop" \
    "$pkgdir/usr/share/applications/wood-booster-hq.desktop"

  install -Dm644 \
    "$srcdir/icon-32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/wood-booster-hq.png"

  install -Dm644 \
    "$srcdir/icon-128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/wood-booster-hq.png"

  install -Dm644 \
    "$srcdir/icon-256.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/wood-booster-hq.png"

  install -Dm644 \
    "$srcdir/icon-512.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/wood-booster-hq.png"

  mkdir -p \
    "$pkgdir/usr/lib/Wood-Booster HQ/resources"

  cp -r \
    "$startdir/server" \
    "$pkgdir/usr/lib/Wood-Booster HQ/resources/server"

  cp -r \
    "$startdir/pybackend" \
    "$pkgdir/usr/lib/Wood-Booster HQ/resources/pybackend"
}
